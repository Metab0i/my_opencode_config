{
  "name": "plan-critic",
  "description": "Plan a task, critique it, and loop back to re-plan until the critic passes. Declarative workflow using two focused subagents (plan-json + critic-json).",
  "input": {
    "type": "json_schema",
    "schema": {
      "type": "object",
      "properties": { "request": { "type": "string" } },
      "required": ["request"],
      "additionalProperties": false
    }
  },
  "steps": [
    {
      "id": "plan",
      "agent": "plan-json",
      "thinking": "off",
      "prompt": [
        "Request to plan:\n\n{{input.request}}",
        "Prior critic findings to address (from the previous iteration, if any):\n{{critic.foundIssues || (none yet — first pass)}}"
      ],
      "output": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "properties": { "plan": { "type": "string" } },
          "required": ["plan"],
          "additionalProperties": false
        }
      },
      "routes": [{ "when": { "op": "exists", "field": "plan" }, "next": "critic" }]
    },
    {
      "id": "critic",
      "agent": "critic-json",
      "thinking": "off",
      "prompt": "Original request:\n{{input.request}}\n\nPlan to critique:\n{{plan.plan}}",
      "output": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "properties": {
            "foundIssues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": { "enum": ["high", "medium", "low"] },
                  "section": { "type": "string" },
                  "message": { "type": "string" }
                },
                "required": ["severity", "section", "message"],
                "additionalProperties": false
              }
            },
            "verdict": { "enum": ["PASS", "REVISION"] }
          },
          "required": ["foundIssues", "verdict"],
          "additionalProperties": false
        }
      },
      "routes": [
        { "when": { "op": "equals", "field": "verdict", "value": "REVISION" }, "next": "plan" }
      ]
    }
  ],
  "start": "plan",
  "maxIterations": 5
}
