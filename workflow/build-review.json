{
  "name": "build-review",
  "description": "Implement a task, review the implementation against the plan via git, and loop back to fix findings until the reviewer passes. Declarative build workflow using just two agents (build + reviewer-json).",
  "input": {
    "type": "json_schema",
    "schema": {
      "type": "object",
      "properties": { "request": { "type": "string" } },
      "required": ["request"],
      "additionalProperties": false
    }
  },
  "steps": [
    {
      "id": "build",
      "agent": "build",
      "thinking": "off",
      "prompt": [
        "Implement the following task:\n\n{{input.request}}",
        "Follow ~/.config/opencode/instructions/build-principles.md. Read the plan at plan_path() first if one exists.",
        "Prior reviewer findings to address (from the previous iteration, if any):\n{{review.foundIssues || (none yet — first pass)}}"
      ],
      "output": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "properties": { "summary": { "type": "string" } },
          "required": ["summary"],
          "additionalProperties": false
        }
      },
      "routes": [{ "when": { "op": "exists", "field": "summary" }, "next": "review" }]
    },
    {
      "id": "review",
      "agent": "reviewer-json",
      "thinking": "off",
      "prompt": "Original request:\n{{input.request}}\n\nImplementer's summary:\n{{build.summary}}",
      "output": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "properties": {
            "foundIssues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": { "enum": ["high", "medium", "low"] },
                  "where": { "type": "string" },
                  "message": { "type": "string" }
                },
                "required": ["severity", "where", "message"],
                "additionalProperties": false
              }
            },
            "verdict": { "enum": ["PASS", "CHANGES_REQUIRED"] }
          },
          "required": ["foundIssues", "verdict"],
          "additionalProperties": false
        }
      },
      "routes": [
        { "when": { "op": "equals", "field": "verdict", "value": "CHANGES_REQUIRED" }, "next": "build" }
      ]
    }
  ],
  "start": "build",
  "maxIterations": 4
}
