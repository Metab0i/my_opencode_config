{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  "permission": {
    "*": "ask"
  },
  "agent": {
    "plan": {"disable": true},
    "planner": {
      "prompt": "{file:./prompts/plan.md}",
      "temperature": 0.1,
      "model": "opencode-go/deepseek-v4-pro",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
	"write": {"*": "deny", "/tmp/**": "allow" },
        "list": "allow",
        "webfetch": "allow",
        "edit": { "*": "deny", "/tmp/**": "allow" },
        "bash": "deny",
        "task": { "*": "deny", "scout": "allow", "validator": "allow" },
        "question": "allow",
        "plan_path": "allow",
        "session_id": "allow",
        "external_directory": { "/tmp/**": "allow" }
      }
    },
    "reviewer": {
      "prompt": "{file:./prompts/reviewer.md}",
      "color": "#fb2b80",
      "model": "opencode-go/glm-5.3",
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "edit": "deny",
        "bash": {
          "*": "ask",
        },
        "task": "deny",
        "question": "allow",
        "skill": "allow",
        "session_id": "allow",
        "external_directory": { "/tmp/**": "allow" }
      }
    },
    "build": {
      "prompt": "{file:./prompts/build.md}",
      "color": "#2bfbda",
      "model": "opencode-go/deepseek-v4.1-flash",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "edit": "allow",
        "bash": "ask",
        "task": "deny",
        "question": "allow",
        "plan_path": "allow",
        "session_id": "allow",
        "external_directory": { "/tmp/**": "allow" }
      }
    },
    "scout": {
      "mode": "subagent",
      "description": "Fast read-only discovery and investigation agent for what/where/how/which questions — where things live, what they do, what tools/docs/examples exist, how they're used — answered from the workspace and the web with cited evidence.",
      "prompt": "{file:./prompts/scout.md}",
      "model": "opencode-go/qwen3.8-flash",
      "temperature": 0.1,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "session_id": "allow",
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "git blame*": "allow"
        },
        "task": "deny",
        "external_directory": { "/tmp/**": "allow" }
      }
    },
    "validator": {
      "mode": "subagent",
      "description": "Empirically tests a hypothesis by building and running the smallest prototype that confirms or denies it; used by the planner to prove rather than assert.",
      "prompt": "{file:./prompts/validator.md}",
      "model": "opencode-go/deepseek-v4.1-flash",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "session_id": "allow",
        "edit": { "*": "deny", "/tmp/**": "allow" },
        "bash": "ask",
        "task": "deny",
        "external_directory": { "/tmp/**": "allow" }
      }
    }
  }
}
