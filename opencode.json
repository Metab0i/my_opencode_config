{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": {
    "*": "ask"
  },
  "agent": {
    "plan": {
      "prompt": "{file:./prompts/plan.md}",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "edit": { "*": "ask", "/tmp/**": "allow" },
        "bash": "ask",
        "task": "deny",
        "question": "allow",
        "plan_path": "allow",
        "external_directory": { "/tmp/**": "allow" }
      }
    },
    "reviewer": {
      "prompt": "{file:./prompts/reviewer.md}",
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "edit": "deny",
        "bash": {
          "*": "ask",
          "node ~/.config/opencode/skills/verify-json/scripts/verifyjson.mjs *": "allow"
        },
        "task": "deny",
        "question": "allow",
        "skill": "allow",
        "external_directory": { "/tmp/**": "allow" }
      }
    },
    "build": {
      "prompt": "{file:./prompts/build.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "edit": "allow",
        "bash": "ask",
        "task": "deny",
        "question": "allow",
        "plan_path": "allow",
        "external_directory": { "/tmp/**": "allow" }
      }
    }
  }
}
