{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": {
    "*": "ask"
  },
  "agent": {
    "plan": {
      "prompt": "{file:./prompts/plan.md}",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "edit": { "*": "ask", "/tmp/**": "allow" },
        "bash": "ask",
        "task": "allow",
        "question": "allow",
        "plan_path": "allow",
        "external_directory": { "/tmp/**": "allow" }
      }
    },
    "reviewer": {
      "prompt": "{file:./prompts/reviewer.md}",
      "color": "#fb2b80",
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "edit": "deny",
        "bash": {
          "*": "ask",
          "node -e 'const r = *; process.stdout.write(JSON.stringify(r, null, 2) + \"\\n\")'": "allow"
        },
        "task": "deny",
        "question": "allow",
        "skill": "allow",
        "external_directory": { "/tmp/**": "allow" }
      }
    },
    "build": {
      "prompt": "{file:./prompts/build.md}",
      "color": "#2bfbda",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "edit": "allow",
        "bash": "ask",
        "task": "deny",
        "question": "allow",
        "plan_path": "allow",
        "external_directory": { "/tmp/**": "allow" }
      }
    },
    "scout": {
      "mode": "subagent",
      "description": "Fast read-only discovery and investigation agent for what/where/how/which questions — where things live, what they do, what tools/docs/examples exist, how they're used — answered from the workspace and the web with cited evidence.",
      "prompt": "{file:./prompts/scout.md}",
      "model": "opencode-go/qwen3.8-flash",
      "temperature": 0.1,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "git blame*": "allow"
        },
        "task": "deny",
        "external_directory": { "/tmp/**": "allow" }
      }
    }
  }
}
